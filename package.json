{
  "name": "cafe-mokatta-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ghpages": "ng build --configuration production --base-href /Cafe_Mokatta_Frontend/ && node scripts/copy-spa-routes.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lhci:collect": "lhci collect --config=./lighthouserc.cjs",
    "lhci:assert": "lhci assert --config=./lighthouserc.cjs",
    "lhci:upload": "lhci upload --config=./lighthouserc.cjs",
    "lhci:autorun": "npm run build && lhci autorun --config=./lighthouserc.cjs",
    "lhci:ghpages": "lighthouse https://jarethjaziel.github.io/Cafe_Mokatta_Frontend/ --preset=desktop --only-categories=performance,accessibility,best-practices --output=html --output=json --output-path=../evidencias/lhci-reports/ghpages-report"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "ngx-pagination": "^6.0.3",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.24",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@lhci/cli": "^0.16.1",
    "jsdom": "^27.1.0",
    "lighthouse": "^13.6.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
